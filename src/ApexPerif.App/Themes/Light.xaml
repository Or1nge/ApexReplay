<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Light palette; swapped at runtime by Themes.Apply. -->
 <SolidColorBrush x:Key="WindowBrush" Color="#EEEFF2"/>
 <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F7F9"/>
 <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="ControlBrush" Color="#F0F0F3"/>
 <SolidColorBrush x:Key="ControlHoverBrush" Color="#E7E7EB"/>
 <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="LineBrush" Color="#E6E6EA"/>
 <SolidColorBrush x:Key="LineHoverBrush" Color="#D3D4DA"/>
 <SolidColorBrush x:Key="TextBrush" Color="#18181B"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#62636B"/>
 <SolidColorBrush x:Key="SubtleBrush" Color="#9A9BA3"/>
 <SolidColorBrush x:Key="Accent" Color="#E5484D"/>
 <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FE5484D"/>
 <SolidColorBrush x:Key="GoodBrush" Color="#1F9D5C"/>
 <SolidColorBrush x:Key="WarnBrush" Color="#B86E00"/>
 <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFF4E0"/>
 <SolidColorBrush x:Key="WarnLineBrush" Color="#F2D49B"/>
 <SolidColorBrush x:Key="OverlayBrush" Color="#000000"/>
 <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="ThumbLineBrush" Color="#C9CAD1"/>
 <SolidColorBrush x:Key="InverseBrush" Color="#FFFFFF"/>
</ResourceDictionary>
