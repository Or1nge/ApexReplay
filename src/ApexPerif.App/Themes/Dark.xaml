 <SolidColorBrush x:Key="TextBrush" Color="#E9EEF5"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#8B97A8"/>
 <SolidColorBrush x:Key="SubtleBrush" Color="#5D697B"/>
 <SolidColorBrush x:Key="Accent" Color="#F0484E"/>
 <SolidColorBrush x:Key="GoodBrush" Color="#3DD68C"/>
 <SolidColorBrush x:Key="WarnBrush" Color="#F5A524"/>
 <SolidColorBrush x:Key="WarnSoftBrush" Color="#2B2214"/>
