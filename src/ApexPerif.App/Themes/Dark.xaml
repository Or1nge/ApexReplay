 <SolidColorBrush x:Key="ControlBrush" Color="#1C222D"/>
 <SolidColorBrush x:Key="ControlHoverBrush" Color="#242B38"/>
 <SolidColorBrush x:Key="PopupBrush" Color="#1A2029"/>
 <SolidColorBrush x:Key="LineBrush" Color="#232A36"/>
