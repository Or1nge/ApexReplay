<Application x:Class="ApexPerif.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#44D9B3"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECF1F7"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#272C38"/><Setter Property="Foreground" Value="#EDF3F8"/>
   <Setter Property="Padding" Value="18,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Body" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="Minimum" Value="0"/><Setter Property="TickFrequency" Value="1"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#ECF1F7"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#11151B"/><Setter Property="Padding" Value="6"/></Style>
 </Application.Resources>
</Application>
