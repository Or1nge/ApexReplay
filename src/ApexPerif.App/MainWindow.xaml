<Window x:Class="ApexPerif.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Apex回放" Icon="Assets/apex-replay.ico" Width="650" Height="770" MinWidth="580" MinHeight="630"
 Background="#11151C" Foreground="#ECF1F7" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <DataTemplate x:Key="VideoOptionLabel"><TextBlock Text="{Binding Name}" Foreground="#11151B"/></DataTemplate>
  <Style x:Key="AudioMeter" TargetType="ProgressBar">
   <Setter Property="Maximum" Value="1"/><Setter Property="Height" Value="8"/>
   <Setter Property="Background" Value="#28323F"/><Setter Property="Foreground" Value="#44D9B3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="4"/>
     <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/></Grid>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="32,28">
  <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Apex回放" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="让精彩交战，自己留下来。" Foreground="#8D9AAF" Margin="0,8,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="#202A30" CornerRadius="5" VerticalAlignment="Top" Padding="9,5">
    <TextBlock Text="{Binding VideoSummary}" Foreground="#67D5B7" FontSize="11"/>
   </Border>
  </Grid>
  <Border Background="#1A202B" CornerRadius="12" Padding="22" Margin="0,0,0,22">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <TextBlock Grid.Column="1" Text="{Binding StatusTitle}" FontSize="19" FontWeight="Medium"/>
    </Grid>
    <TextBlock Text="{Binding StatusDetail}" Foreground="#A4B1C5" Margin="19,10,0,0" TextWrapping="Wrap" LineHeight="21"/>
    <TextBlock Text="{Binding BufferDetail}" Foreground="#738399" FontSize="11" Margin="19,12,0,0"/>
    <TextBlock Text="{Binding LastSaved}" Foreground="#62D2B1" FontSize="11" Margin="19,7,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </Border>
  <TextBlock Text="素材保存到" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Background="#1A202B" CornerRadius="8" Padding="13,11" Margin="0,0,10,0">
    <TextBlock Text="{Binding OutputDisplay}" Foreground="#A4B1C5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding OutputDirectory}"/>
   </Border>
   <Button Grid.Column="1" Content="选择目录" Click="Browse_Click"/>
  </Grid>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Content="{Binding StartButtonText}" Background="#44D9B3" Foreground="#092C23" FontWeight="SemiBold" FontSize="14" Padding="20,13"
    Click="Start_Click" IsEnabled="{Binding Ready}" Margin="0,0,10,0"/>
   <Button Grid.Column="1" Content="打开文件夹" Click="OpenFolder_Click"/>
  </Grid>
  <Expander Header="画质、缓存、片段与声音" IsExpanded="False">
   <StackPanel Margin="0,18,0,0">
    <TextBlock Text="视频画质" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid IsEnabled="{Binding VideoSettingsEnabled}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="分辨率" VerticalAlignment="Center"/>
     <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding VideoResolutions}" ItemTemplate="{StaticResource VideoOptionLabel}" SelectedValuePath="Id" SelectedValue="{Binding VideoResolution, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Grid.Row="1" Text="编码格式" VerticalAlignment="Center" Margin="0,10,0,0"/>
     <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding VideoCodecs}" ItemTemplate="{StaticResource VideoOptionLabel}" SelectedValuePath="Id" SelectedValue="{Binding VideoCodec, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="2" Text="视频码率" VerticalAlignment="Center" Margin="0,12,0,0"/>
     <Slider Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding VideoBitrateMbps, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"/>
     <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding VideoBitrateMbps, StringFormat={}{0:0} Mbps}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0"/>
     <TextBlock Grid.Row="3" Text="编码预设" VerticalAlignment="Center" Margin="0,12,0,0"/>
     <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding VideoPresets}" ItemTemplate="{StaticResource VideoOptionLabel}" SelectedValuePath="Id" SelectedValue="{Binding VideoPreset, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"/>
    </Grid>
    <TextBlock Text="默认跟随游戏分辨率；手动选择后会记住。目标 60 帧，画质优先更占 GPU；码率越高，缓存占用越多。停止采集后可修改视频配置，下次启动采集生效。" Foreground="#738399" FontSize="11" Margin="0,10,0,22" TextWrapping="Wrap"/>
    <TextBlock Text="回放缓存上限" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
     <TextBlock Text="最长保留"/><Slider Grid.Column="1" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ReplayMinutes, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Grid.Column="2" Text="{Binding ReplayMinutes, StringFormat={}{0:0} 分钟}" HorizontalAlignment="Right"/>
    </Grid>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
     <TextBlock Text="闲置内存占比"/><Slider Grid.Column="1" Minimum="10" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MemoryPercent, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Grid.Column="2" Text="{Binding MemoryPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right"/>
    </Grid>
    <TextBlock Text="按两项上限共同控制；内存紧张时自动缩短历史缓存。" Foreground="#738399" FontSize="11" Margin="0,10,0,20" TextWrapping="Wrap"/>
    <TextBlock Text="长镜头 · 连续交战" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock Text="仅保存连续交战中的多次击倒 / 淘汰，单次爆发不单独保存。" Foreground="#738399" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
     <TextBlock Text="开始前保留"/><Slider Grid.Column="1" Maximum="30" Value="{Binding LongPre, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Grid.Column="2" Text="{Binding LongPre, StringFormat={}{0:0} 秒}" HorizontalAlignment="Right"/>
    </Grid>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
     <TextBlock Text="结束后保留"/><Slider Grid.Column="1" Maximum="20" Value="{Binding LongPost, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Grid.Column="2" Text="{Binding LongPost, StringFormat={}{0:0} 秒}" HorizontalAlignment="Right"/>
    </Grid>
    <TextBlock Text="三轨声音 · 实时电平" FontWeight="SemiBold" Margin="0,24,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="Apex" Foreground="#94A3B8"/><ProgressBar Grid.Column="1" Value="{Binding GameLevel}" Style="{StaticResource AudioMeter}"/>
     <TextBlock Grid.Column="2" Text="{Binding GameAudioStatus}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     <TextBlock Grid.Row="1" Text="自己麦克风" Foreground="#94A3B8" Margin="0,9,0,0"/><ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding MicLevel}" Style="{StaticResource AudioMeter}" Margin="0,9,0,0"/>
     <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MicAudioStatus}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,9,0,0"/>
     <TextBlock Grid.Row="2" Text="其他应用" Foreground="#94A3B8" Margin="0,9,0,0"/><ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding DesktopLevel}" Style="{StaticResource AudioMeter}" Margin="0,9,0,0"/>
     <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DesktopAudioStatus}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,9,0,0"/>
    </Grid>
    <TextBlock Text="{Binding AudioMeterHint}" Foreground="#738399" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <Grid Margin="0,16,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="麦克风" VerticalAlignment="Center"/>
     <ComboBox Grid.Column="1" ItemsSource="{Binding Microphones}" SelectedValuePath="Id" SelectedValue="{Binding MicrophoneId, UpdateSourceTrigger=PropertyChanged}">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#11151B"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
    </Grid>
    <CheckBox Content="自己的麦克风降噪" IsChecked="{Binding MicNoiseSuppression, UpdateSourceTrigger=PropertyChanged}" Foreground="#ECF1F7" Margin="90,4,0,0"/>
    <TextBlock Text="降低风扇、空调等持续背景噪声，仅处理自己的麦克风。" Foreground="#738399" FontSize="11" Margin="90,7,0,8" TextWrapping="Wrap"/>
    <TextBlock Text="自动平衡 · 自己 / 其他声音" Foreground="#94A3B8" FontSize="12" Margin="0,8,0,8"/>
    <Slider Minimum="-12" Maximum="12" Value="{Binding Balance, UpdateSourceTrigger=PropertyChanged}"/>
    <Grid Margin="0,6,0,0"><TextBlock Text="偏队友与其他应用" Foreground="#738399" FontSize="11"/><TextBlock Text="偏自己的麦克风" Foreground="#738399" FontSize="11" HorizontalAlignment="Right"/></Grid>
    <TextBlock Text="音轨分别保存；游戏内队伍语音随 Apex 留在第一轨。" Foreground="#738399" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Expander>
  <Button Content="重试失败的保存" Click="Retry_Click" Visibility="{Binding RetryVisibility}" Margin="0,18,0,0"/>
  <TextBlock Text="关闭窗口后继续在托盘运行" Foreground="#55647A" FontSize="11" HorizontalAlignment="Center" Margin="0,25,0,0"/>
 </StackPanel>
 </ScrollViewer>
</Window>
