<Window x:Class="ApexPerif.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ApexPerif"
 Title="Apex回放" Icon="Assets/apex-replay.ico" Width="680" Height="820" MinWidth="560" MinHeight="600"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
 TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <local:EqualsConverter x:Key="Is"/>
  <!-- Segmented appearance switch in the header -->
  <Style x:Key="ThemeOption" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Body" Width="30" Height="24" CornerRadius="10" Background="Transparent">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource ControlHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="22,18"/>
   <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="CardIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
   <Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Value" TargetType="TextBlock">
   <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  </Style>
  <Style x:Key="StatLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="StatValue" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,4,0,2"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="StatNote" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="AudioMeter" TargetType="ProgressBar">
   <Setter Property="Maximum" Value="1"/><Setter Property="Height" Value="6"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="3"/>
     <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/></Grid>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Start / stop: accent when idle, neutral while capturing. -->
  <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Style.Triggers>
    <DataTrigger Binding="{Binding Running}" Value="True">
     <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
     <Setter Property="BorderBrush" Value="{DynamicResource LineHoverBrush}"/>
     <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <!-- Soft halo behind the status dot; it pulses while capture is running. -->
  <Style x:Key="Halo" TargetType="Ellipse">
   <Setter Property="Opacity" Value=".22"/>
   <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Running}" Value="True">
     <DataTrigger.EnterActions><BeginStoryboard x:Name="Pulse"><Storyboard RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From=".6" To="1.25" Duration="0:0:1.6"/>
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From=".6" To="1.25" Duration="0:0:1.6"/>
      <DoubleAnimation Storyboard.TargetProperty="Opacity" From=".45" To="0" Duration="0:0:1.6"/>
     </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
     <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse"/></DataTrigger.ExitActions>
    </DataTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="28,22,28,14">

  <!-- Header -->
  <Grid Margin="2,0,2,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image x:Name="HeaderIcon" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
   <TextBlock Grid.Column="1" Text="Apex回放" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="2" VerticalAlignment="Center" Margin="0,0,10,0">
    <StackPanel Orientation="Horizontal">
     <RadioButton Style="{StaticResource ThemeOption}" IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter=auto}" ToolTip="自动：7:00–19:00 浅色，其余时间深色">
      <TextBlock Text="&#xE823;" Style="{StaticResource IconText}" FontSize="12"/></RadioButton>
     <RadioButton Style="{StaticResource ThemeOption}" IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter=light}" ToolTip="浅色">
      <TextBlock Text="&#xE706;" Style="{StaticResource IconText}" FontSize="12"/></RadioButton>
     <RadioButton Style="{StaticResource ThemeOption}" IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter=dark}" ToolTip="深色">
      <TextBlock Text="&#xE708;" Style="{StaticResource IconText}" FontSize="12"/></RadioButton>
    </StackPanel>
   </Border>
   <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="11,5" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="&#xE714;" Style="{StaticResource IconText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,7,0"/>
     <TextBlock Text="{Binding VideoSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
    </StackPanel>
   </Border>
  </Grid>

  <!-- Status -->
  <Border Style="{StaticResource Card}" Padding="24,22">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
      <StackPanel Orientation="Horizontal">
       <Grid Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
        <Ellipse Fill="{Binding StatusBrush}" Style="{StaticResource Halo}"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
        <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}"/>
       </Grid>
       <TextBlock Text="{Binding StatusTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource MutedBrush}" Margin="32,6,0,0" TextWrapping="Wrap" LineHeight="20">
       <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
     <Button Grid.Column="1" Style="{StaticResource StartButton}" Click="Start_Click" IsEnabled="{Binding Ready}" MinWidth="148" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding StartButtonIcon}" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,9,0"/>
       <TextBlock Text="{Binding StartButtonText}"/>
      </StackPanel>
     </Button>
    </Grid>
    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20,0,16"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0">
      <TextBlock Text="已缓存" Style="{StaticResource StatLabel}"/>
      <TextBlock Text="{Binding BufferTime}" Style="{StaticResource StatValue}"/>
      <TextBlock Text="{Binding ReplayMinutes, StringFormat='上限 {0:0} 分钟'}" Style="{StaticResource StatNote}"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,12,0">
      <TextBlock Text="缓存占用" Style="{StaticResource StatLabel}"/>
      <TextBlock Text="{Binding BufferSize}" Style="{StaticResource StatValue}"/>
      <TextBlock Text="{Binding MemoryBudget}" Style="{StaticResource StatNote}"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="已保存" Style="{StaticResource StatLabel}"/>
      <TextBlock Text="{Binding SavedCount, StringFormat={}{0} 段}" Style="{StaticResource StatValue}"/>
      <TextBlock Text="{Binding LastSaved}" ToolTip="{Binding LastSaved}">
       <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatNote}"><Style.Triggers>
        <Trigger Property="Text" Value=""><Setter Property="ToolTipService.IsEnabled" Value="False"/></Trigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
    </Grid>
    <Button Click="Retry_Click" Visibility="{Binding RetryVisibility}" Margin="0,16,0,0" HorizontalAlignment="Left"
     Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnLineBrush}" Foreground="{DynamicResource WarnBrush}">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
      <TextBlock Text="重试保存"/>
     </StackPanel>
    </Button>
   </StackPanel>
  </Border>

  <!-- Output directory -->
  <Border Style="{StaticResource Card}" Padding="18,12,12,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="&#xE8B7;" Style="{StaticResource CardIcon}" FontSize="16" Margin="0,0,12,0"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
     <TextBlock Text="保存位置" Style="{StaticResource StatLabel}"/>
     <TextBlock Text="{Binding OutputDisplay}" ToolTip="{Binding OutputDirectory}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
    </StackPanel>
    <Button Grid.Column="2" Content="更改" Click="Browse_Click" Margin="0,0,8,0"/>
    <Button Grid.Column="3" Click="OpenFolder_Click" ToolTip="打开文件夹" Padding="11,8">
     <TextBlock Text="&#xE838;" Style="{StaticResource IconText}"/>
    </Button>
   </Grid>
  </Border>

  <!-- Video -->
  <Border Style="{StaticResource Card}">
   <StackPanel>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="&#xE714;" Style="{StaticResource CardIcon}"/>
     <TextBlock Grid.Column="1" Text="视频" Style="{StaticResource CardTitle}"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding Running, Converter={StaticResource Visible}}">
      <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,6,0"/>
      <TextBlock Text="停止采集后可修改" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
     </StackPanel>
    </Grid>
    <Grid IsEnabled="{Binding VideoSettingsEnabled}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="分辨率" Style="{StaticResource Label}"/>
     <ComboBox Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding VideoResolutions}" SelectedValuePath="Id" SelectedValue="{Binding VideoResolution, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Grid.Row="1" Text="编码" Style="{StaticResource Label}" Margin="0,10,0,0"/>
     <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding VideoCodecs}" SelectedValuePath="Id" SelectedValue="{Binding VideoCodec, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="2" Text="预设" Style="{StaticResource Label}" Margin="0,10,0,0"/>
     <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding VideoPresets}" SelectedValuePath="Id" SelectedValue="{Binding VideoPreset, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="3" Text="码率" Style="{StaticResource Label}" Margin="0,14,0,0"/>
     <Slider Grid.Row="3" Grid.Column="1" Minimum="10" Maximum="200" TickFrequency="5" Value="{Binding VideoBitrateMbps, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,0"/>
     <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding VideoBitrateMbps, StringFormat={}{0:0} Mbps}" Style="{StaticResource Value}" Margin="0,14,0,0"/>
    </Grid>
   </StackPanel>
  </Border>

  <!-- Replay buffer and clip timing -->
  <Border Style="{StaticResource Card}">
   <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
     <TextBlock Text="&#xE81C;" Style="{StaticResource CardIcon}"/>
     <TextBlock Text="缓存与片段" Style="{StaticResource CardTitle}"/>
    </StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="缓存时长" Style="{StaticResource Label}"/>
     <Slider Grid.Column="1" Minimum="1" Maximum="120" Value="{Binding ReplayMinutes, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Grid.Column="2" Text="{Binding ReplayMinutes, StringFormat={}{0:0} 分钟}" Style="{StaticResource Value}"/>
     <TextBlock Grid.Row="1" Text="内存占比" Style="{StaticResource Label}" Margin="0,10,0,0" ToolTip="最多使用的闲置内存比例"/>
     <Slider Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="90" TickFrequency="5" Value="{Binding MemoryPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MemoryPercent, StringFormat={}{0:0}%}" Style="{StaticResource Value}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="2" Text="片段前" Style="{StaticResource Label}" Margin="0,10,0,0" ToolTip="连杀开始前保留的时长"/>
     <Slider Grid.Row="2" Grid.Column="1" Maximum="30" Value="{Binding LongPre, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LongPre, StringFormat={}{0:0} 秒}" Style="{StaticResource Value}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="3" Text="片段后" Style="{StaticResource Label}" Margin="0,10,0,0" ToolTip="连杀结束后保留的时长"/>
     <Slider Grid.Row="3" Grid.Column="1" Maximum="20" Value="{Binding LongPost, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LongPost, StringFormat={}{0:0} 秒}" Style="{StaticResource Value}" Margin="0,10,0,0"/>
    </Grid>
   </StackPanel>
  </Border>

  <!-- Audio -->
  <Border Style="{StaticResource Card}">
   <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
     <TextBlock Text="&#xE767;" Style="{StaticResource CardIcon}"/>
     <TextBlock Text="声音" Style="{StaticResource CardTitle}"/>
    </StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="Apex" Style="{StaticResource Label}"/>
     <ProgressBar Grid.Column="1" Value="{Binding GameLevel}" Style="{StaticResource AudioMeter}"/>
     <TextBlock Grid.Column="2" Text="{Binding GameAudioStatus}" Style="{StaticResource Value}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
     <TextBlock Grid.Row="1" Text="麦克风" Style="{StaticResource Label}" Margin="0,10,0,0"/>
     <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding MicLevel}" Style="{StaticResource AudioMeter}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MicAudioStatus}" Style="{StaticResource Value}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="2" Text="其他应用" Style="{StaticResource Label}" Margin="0,10,0,0"/>
     <ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding DesktopLevel}" Style="{StaticResource AudioMeter}" Margin="0,10,0,0"/>
     <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DesktopAudioStatus}" Style="{StaticResource Value}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
    </Grid>
    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,16"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="麦克风设备" Style="{StaticResource Label}"/>
     <ComboBox Grid.Column="1" ItemsSource="{Binding Microphones}" SelectedValuePath="Id" SelectedValue="{Binding MicrophoneId, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Grid.Row="1" Text="降噪" Style="{StaticResource Label}" Margin="0,14,0,0"/>
     <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding MicNoiseSuppression, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="0,14,0,0"
      ToolTip="抑制风扇、空调等持续噪声"/>
     <TextBlock Grid.Row="2" Text="音量平衡" Style="{StaticResource Label}" Margin="0,14,0,0"/>
     <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource CenterSlider}" Minimum="-12" Maximum="12" Value="{Binding Balance, UpdateSourceTrigger=PropertyChanged}" Margin="0,14,0,0"/>
     <Grid Grid.Row="3" Grid.Column="1" Margin="0,2,0,0">
      <TextBlock Text="其他声音" Foreground="{DynamicResource SubtleBrush}" FontSize="11"/>
      <TextBlock Text="麦克风" Foreground="{DynamicResource SubtleBrush}" FontSize="11" HorizontalAlignment="Right"/>
     </Grid>
    </Grid>
   </StackPanel>
  </Border>
 </StackPanel>
 </ScrollViewer>
</Window>
