<Window x:Class="ApexPerif.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ApexPerif"
 Title="Apex回放" Icon="Assets/apex-replay.ico" Width="980" Height="660" MinWidth="820" MinHeight="580"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
 TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <local:EqualsConverter x:Key="Is"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Subtle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Value" TargetType="TextBlock">
   <Setter Property="Width" Value="68"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  </Style>
  <Style x:Key="NumberInput" TargetType="TextBox">
   <Setter Property="Width" Value="64"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="12,0,0,0"/>
   <Setter Property="Padding" Value="6,3"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineHoverBrush}"/>
   <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
   <EventSetter Event="KeyDown" Handler="NumberInput_KeyDown"/><EventSetter Event="LostFocus" Handler="NumberInput_LostFocus"/>
  </Style>
  <Style x:Key="Bar" TargetType="ProgressBar">
   <Setter Property="Maximum" Value="1"/><Setter Property="Height" Value="6"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="3"/>
     <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/></Grid>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AudioMeter" TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
   <Setter Property="Height" Value="4"/><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
  </Style>

  <!-- Sidebar navigation item; the icon glyph goes in Tag. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Margin" Value="0,0,0,2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid Height="36">
     <Border x:Name="Body" CornerRadius="6" Background="Transparent"/>
     <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Visibility="Collapsed"/>
     <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
      <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource IconText}" FontSize="15" Margin="0,0,12,0"/>
      <ContentPresenter VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource ControlBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Body" Property="Background" Value="{DynamicResource ControlBrush}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- One option of a segmented control -->
  <Style x:Key="Segment" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Body" CornerRadius="5" Padding="14,5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
     <ContentPresenter HorizontalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="Body" Property="Background" Value="{DynamicResource CardBrush}"/><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Large round start / stop button: a red dot when idle, a red square with a ring while capturing. -->
  <Style x:Key="RecordButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Root" Width="96" Height="96" Background="Transparent">
     <Ellipse x:Name="Ring" Stroke="{DynamicResource Accent}" StrokeThickness="2" Opacity="0"/>
     <Ellipse Margin="7" Fill="{DynamicResource ControlBrush}" Stroke="{DynamicResource LineHoverBrush}" StrokeThickness="1"/>
     <Ellipse x:Name="Overlay" Margin="7" Fill="{DynamicResource OverlayBrush}" Opacity="0"/>
     <Ellipse x:Name="Dot" Width="30" Height="30" Fill="{DynamicResource Accent}"/>
     <Rectangle x:Name="Square" Width="24" Height="24" RadiusX="5" RadiusY="5" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <DataTrigger Binding="{Binding Running}" Value="True">
      <Setter TargetName="Ring" Property="Opacity" Value=".45"/><Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/><Setter TargetName="Square" Property="Visibility" Value="Visible"/>
     </DataTrigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value=".06"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value=".12"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Clip row: the whole row opens the video. -->
  <Style x:Key="ClipRow" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Body" CornerRadius="8" Padding="10,8" Background="Transparent"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource ControlBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource ControlBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Settings page: a group of rows separated by hairlines -->
  <Style x:Key="Section" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="Margin" Value="2,24,0,8"/>
  </Style>
  <Style x:Key="Row" TargetType="Grid">
   <Setter Property="MinHeight" Value="54"/><Setter Property="Margin" Value="16,0"/>
  </Style>
  <Style x:Key="Rule" TargetType="Border">
   <Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource LineBrush}"/>
  </Style>
  <!-- Soft halo behind the status dot; it pulses while capture is running. -->
  <Style x:Key="Halo" TargetType="Ellipse">
   <Setter Property="Opacity" Value=".22"/>
   <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Running}" Value="True">
     <DataTrigger.EnterActions><BeginStoryboard x:Name="Pulse"><Storyboard RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From=".6" To="1.3" Duration="0:0:1.6"/>
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From=".6" To="1.3" Duration="0:0:1.6"/>
      <DoubleAnimation Storyboard.TargetProperty="Opacity" From=".45" To="0" Duration="0:0:1.6"/>
     </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
     <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse"/></DataTrigger.ExitActions>
    </DataTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>

  <!-- Sidebar -->
  <DockPanel Margin="10,8,10,14">
   <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="14,0,0,0">
    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
   </StackPanel>
   <StackPanel>
    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="概览" IsChecked="True"/>
    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="设置"/>
   </StackPanel>
  </DockPanel>

  <!-- Content panel -->
  <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,0" CornerRadius="12,0,0,0">
   <Grid>

    <!-- Overview -->
    <Grid Margin="28,24,28,24" Visibility="{Binding IsChecked, ElementName=NavHome, Converter={StaticResource Visible}}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="24,20,20,20">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
         <Grid Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
          <Ellipse Fill="{Binding StatusBrush}" Style="{StaticResource Halo}"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
          <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}"/>
         </Grid>
         <TextBlock Text="{Binding StatusTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource MutedBrush}" Margin="30,4,0,0" TextWrapping="Wrap" LineHeight="19">
         <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
          <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Grid Margin="30,18,0,0">
         <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <DockPanel Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Subtle}" FontSize="13" Text="{Binding ReplayMinutes, StringFormat='&#x2009;/ {0:0}:00'}"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding BufferTime}" FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
          <TextBlock Text="回放缓存" Style="{StaticResource Muted}"/>
         </DockPanel>
         <ProgressBar Grid.Row="1" Style="{StaticResource Bar}" Value="{Binding BufferProgress, Mode=OneWay}"/>
         <DockPanel Grid.Row="2" Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Right" Text="{Binding VideoSummary}" Style="{StaticResource Subtle}"/>
          <TextBlock Text="{Binding MemoryLine}" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
         </DockPanel>
        </Grid>
        <Button Click="Retry_Click" Visibility="{Binding RetryVisibility}" Margin="30,14,0,0" HorizontalAlignment="Left"
         Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnLineBrush}" Foreground="{DynamicResource WarnBrush}">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0"/>
          <TextBlock Text="重试保存"/>
         </StackPanel>
        </Button>
       </StackPanel>
       <StackPanel Grid.Column="1" Margin="28,0,8,0" VerticalAlignment="Center">
        <Button Style="{StaticResource RecordButton}" Click="Start_Click" IsEnabled="{Binding Ready}" ToolTip="{Binding StartButtonText}"/>
        <TextBlock Text="{Binding StartButtonText}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
       </StackPanel>
      </Grid>
     </Border>

     <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
      <!-- Recent clips -->
      <Border Style="{StaticResource Card}" Padding="10,14,10,8">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <DockPanel Margin="12,0,6,8">
         <Button DockPanel.Dock="Right" Click="OpenFolder_Click">
          <StackPanel Orientation="Horizontal">
           <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,7,0"/>
           <TextBlock Text="打开文件夹"/>
          </StackPanel>
         </Button>
         <TextBlock Text="最近片段" Style="{StaticResource CardTitle}"/>
         <TextBlock Text="{Binding SavedCount, StringFormat='本次 {0} 段'}" Margin="10,0,0,0">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}"><Style.Triggers>
           <DataTrigger Binding="{Binding SavedCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="暂无片段" HorizontalAlignment="Center" VerticalAlignment="Center">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
          <DataTrigger Binding="{Binding Clips.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <ItemsControl ItemsSource="{Binding Clips}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Button Style="{StaticResource ClipRow}" Click="Clip_Click" ToolTip="{Binding Path}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <Grid Width="104" Height="58" Margin="0,0,14,0">
              <Border CornerRadius="6" Background="{DynamicResource ControlHoverBrush}">
               <TextBlock Text="&#xE8B2;" Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center"/>
              </Border>
              <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background></Border>
              <Border CornerRadius="4" Background="#A6000000" Padding="5,1" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
               <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
               <Border.Style><Style TargetType="Border"><Style.Triggers>
                <DataTrigger Binding="{Binding Duration}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
               </Style.Triggers></Style></Border.Style>
              </Border>
             </Grid>
             <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
               <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"/>
               <Border CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                Visibility="{Binding SquadWipe, Converter={StaticResource Visible}}">
                <TextBlock Text="全灭" Foreground="{DynamicResource Accent}" FontSize="11"/>
               </Border>
              </StackPanel>
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
             </StackPanel>
             <Button Grid.Column="2" Click="ShowClip_Click" ToolTip="在文件夹中显示" VerticalAlignment="Center">
              <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="13"/>
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
               <Setter Property="Opacity" Value="0"/>
               <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
              </Style></Button.Style>
             </Button>
            </Grid>
           </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
       </Grid>
      </Border>

      <!-- Right column: same top and bottom edges as the clips card -->
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <!-- Live levels of the three recorded tracks -->
       <Border Style="{StaticResource Card}" Padding="18,16,18,16">
        <StackPanel>
         <TextBlock Text="声音" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
         <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding GameAudioStatus}" Style="{StaticResource Subtle}" FontSize="11.5"/><TextBlock Text="Apex"/></DockPanel>
         <ProgressBar Value="{Binding GameLevel}" Style="{StaticResource AudioMeter}" Margin="0,7,0,14"/>
         <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding MicAudioStatus}" Style="{StaticResource Subtle}" FontSize="11.5"/><TextBlock Text="麦克风"/></DockPanel>
         <ProgressBar Value="{Binding MicLevel}" Style="{StaticResource AudioMeter}" Margin="0,7,0,0"/>
         <TextBlock Text="{Binding MicVoice}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,5,0,12" ToolTip="识别出的人声音量与当前平衡增益"/>
         <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DesktopAudioStatus}" Style="{StaticResource Subtle}" FontSize="11.5"/><TextBlock Text="其他应用"/></DockPanel>
         <ProgressBar Value="{Binding DesktopLevel}" Style="{StaticResource AudioMeter}" Margin="0,7,0,0"/>
         <TextBlock Text="{Binding DesktopVoice}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,5,0,0" ToolTip="识别出的人声音量与当前平衡增益；提示音不计入"/>
        </StackPanel>
       </Border>
       <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14,14,14">
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="更改" Click="Browse_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
         <StackPanel VerticalAlignment="Center">
          <TextBlock Text="保存位置" Style="{StaticResource Subtle}"/>
          <TextBlock Text="{Binding OutputDisplay}" ToolTip="{Binding OutputDirectory}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
         </StackPanel>
        </DockPanel>
       </Border>
      </Grid>
     </Grid>
    </Grid>

    <!-- Settings -->
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
     Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource Visible}}">
     <StackPanel Margin="32,22,32,28" MaxWidth="680">
      <TextBlock Text="设置" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="2,0,0,-4"/>

      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,2,8" Visibility="{Binding Running, Converter={StaticResource Visible}}">
        <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,6,0"/>
        <TextBlock Text="采集中不可修改" Style="{StaticResource Subtle}"/>
       </StackPanel>
       <TextBlock Text="视频" Style="{StaticResource Section}"/>
      </DockPanel>
      <Border Style="{StaticResource Card}">
       <StackPanel IsEnabled="{Binding VideoSettingsEnabled}">
        <Grid Style="{StaticResource Row}"><TextBlock Text="分辨率" VerticalAlignment="Center"/>
         <ComboBox Width="230" HorizontalAlignment="Right" ItemsSource="{Binding VideoResolutions}" SelectedValuePath="Id" SelectedValue="{Binding VideoResolution, UpdateSourceTrigger=PropertyChanged}"/></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="编码" VerticalAlignment="Center"/>
         <ComboBox Width="230" HorizontalAlignment="Right" ItemsSource="{Binding VideoCodecs}" SelectedValuePath="Id" SelectedValue="{Binding VideoCodec, UpdateSourceTrigger=PropertyChanged}"/></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="预设" VerticalAlignment="Center"/>
         <ComboBox Width="230" HorizontalAlignment="Right" ItemsSource="{Binding VideoPresets}" SelectedValuePath="Id" SelectedValue="{Binding VideoPreset, UpdateSourceTrigger=PropertyChanged}"/></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="码率" VerticalAlignment="Center"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Slider Width="200" Minimum="10" Maximum="200" TickFrequency="5" Value="{Binding VideoBitrateMbps, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding VideoBitrateMbps, StringFormat={}{0:0} Mbps}" Style="{StaticResource Value}"/>
         </StackPanel></Grid>
       </StackPanel>
      </Border>

      <TextBlock Text="回放" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <Grid Style="{StaticResource Row}"><TextBlock Text="缓存时长" VerticalAlignment="Center"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Slider Width="200" Minimum="1" Maximum="120" Value="{Binding ReplayMinutes, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding ReplayMinutes, StringFormat={}{0:0} 分钟}" Style="{StaticResource Value}"/>
         </StackPanel></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="内存占比" VerticalAlignment="Center" ToolTip="最多使用的闲置内存比例"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Slider Width="200" Minimum="10" Maximum="90" TickFrequency="5" Value="{Binding MemoryPercent, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding MemoryPercent, StringFormat={}{0:0}%}" Style="{StaticResource Value}"/>
         </StackPanel></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="片段前" VerticalAlignment="Center" ToolTip="连杀开始前保留的时长"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Slider Width="200" Maximum="30" Value="{Binding LongPre, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding LongPre, StringFormat={}{0:0} 秒}" Style="{StaticResource Value}"/>
         </StackPanel></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="片段后" VerticalAlignment="Center" ToolTip="连杀结束后保留的时长"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Slider Width="200" Maximum="20" Value="{Binding LongPost, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding LongPost, StringFormat={}{0:0} 秒}" Style="{StaticResource Value}"/>
         </StackPanel></Grid>
       </StackPanel>
      </Border>

      <TextBlock x:Name="CriteriaSection" Text="保存标准" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="同时满足两项伤害条件，并确认击倒、淘汰或助攻。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,16,20,6"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="统计时长" VerticalAlignment="Center"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Slider Width="170" Minimum="1" Maximum="15" TickFrequency=".5" Value="{Binding BurstSeconds, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Style="{StaticResource NumberInput}" Text="{Binding BurstSeconds, StringFormat=0.#, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Text="秒" Style="{StaticResource Muted}" Width="32" Margin="8,0,0,0"/>
         </StackPanel></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="累计伤害 ≥" VerticalAlignment="Center"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Slider Width="170" Minimum="50" Maximum="2000" TickFrequency="10" Value="{Binding BurstDamage, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Style="{StaticResource NumberInput}" Text="{Binding BurstDamage, StringFormat=0, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Text="伤害" Style="{StaticResource Muted}" Width="32" Margin="8,0,0,0"/>
         </StackPanel></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="其中爆发时长" VerticalAlignment="Center"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Slider Width="170" Minimum=".5" Maximum="{Binding BurstSeconds}" TickFrequency=".5" Value="{Binding FastBurstSeconds, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Style="{StaticResource NumberInput}" Text="{Binding FastBurstSeconds, StringFormat=0.#, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Text="秒" Style="{StaticResource Muted}" Width="32" Margin="8,0,0,0"/>
         </StackPanel></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="爆发伤害 &gt;" VerticalAlignment="Center"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Slider Width="170" Minimum="0" Maximum="1000" TickFrequency="10" Value="{Binding FastBurstDamage, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Style="{StaticResource NumberInput}" Text="{Binding FastBurstDamage, StringFormat=0, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Text="伤害" Style="{StaticResource Muted}" Width="32" Margin="8,0,0,0"/>
         </StackPanel></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="连续击倒多人" VerticalAlignment="Center"/><TextBlock Text="自动保存长镜头" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
       </StackPanel>
      </Border>

      <TextBlock Text="声音" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <Grid Style="{StaticResource Row}"><TextBlock Text="麦克风" VerticalAlignment="Center"/>
         <ComboBox Width="268" HorizontalAlignment="Right" ItemsSource="{Binding Microphones}" SelectedValuePath="Id" SelectedValue="{Binding MicrophoneId, UpdateSourceTrigger=PropertyChanged}"/></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="麦克风降噪" VerticalAlignment="Center" ToolTip="抑制风扇、空调等持续噪声"/>
         <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MicNoiseSuppression, UpdateSourceTrigger=PropertyChanged}"/></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="自动人声平衡" VerticalAlignment="Center"
          ToolTip="持续识别麦克风和其他应用里的人声，测量正常说话音量并调到相同响度；提示音、噪声和静音不放大"/>
         <TextBlock Text="麦克风 · 其他应用" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="音量平衡" VerticalAlignment="Center" ToolTip="在自动平衡之后，让麦克风或其他应用更响"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="其他声音" Style="{StaticResource Muted}" Margin="0,0,10,0"/>
          <Slider Width="160" Style="{StaticResource CenterSlider}" Minimum="-12" Maximum="12" Value="{Binding Balance, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="麦克风" Style="{StaticResource Muted}" Margin="10,0,0,0"/>
         </StackPanel></Grid>
       </StackPanel>
      </Border>

      <TextBlock Text="通用" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="保存位置" VerticalAlignment="Center" Margin="0,0,24,0"/>
         <TextBlock Grid.Column="1" Text="{Binding OutputDisplay}" ToolTip="{Binding OutputDirectory}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextAlignment="Right" Margin="0,0,12,0"/>
         <Button Grid.Column="2" Content="更改" Click="Browse_Click" VerticalAlignment="Center"/></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="开机自启" VerticalAlignment="Center" ToolTip="登录 Windows 后在托盘启动并自动等待 Apex"/>
         <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding StartWithWindows, UpdateSourceTrigger=PropertyChanged}"/></Grid>
        <Border Style="{StaticResource Rule}"/>
        <Grid Style="{StaticResource Row}"><TextBlock Text="外观" VerticalAlignment="Center"/>
         <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource ControlBrush}" CornerRadius="7" Padding="2">
          <StackPanel Orientation="Horizontal">
           <RadioButton Style="{StaticResource Segment}" Content="自动" IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter=auto}" ToolTip="7:00–19:00 浅色，其余时间深色"/>
           <RadioButton Style="{StaticResource Segment}" Content="浅色" IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter=light}"/>
           <RadioButton Style="{StaticResource Segment}" Content="深色" IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter=dark}"/>
          </StackPanel>
         </Border></Grid>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Border>
 </Grid>
</Window>
